#include <stdio.h>

int main() {
    int experience, performance;

    printf("Experience: ");
    scanf("%d", &experience);

    printf("Performance: ");
    scanf("%d", &performance);

    if (experience > 7 && performance >= 85) {
        printf("Level: Senior");
    }
    else if (experience >= 3 && experience <= 7 && performance >= 80) {
        printf("Level: Mid-Level");
    }
    else {
        printf("Level: Junior");
    }

    return 0;
}
